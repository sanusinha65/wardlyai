# Copy to .env and restart `npm run dev`
# Free Gemini API key: https://aistudio.google.com/

VITE_GEMINI_API_KEY=

# Optional; default is gemini-2.5-flash (good free-tier choice; separate quota from 2.0-flash)
# VITE_GEMINI_MODEL=gemini-2.5-flash-lite

# Web Speech API language (BCP 47). Defaults to the browser locale if unset.
# Examples: en-US, en-IN, hi-IN
# VITE_SPEECH_LANG=en-US
